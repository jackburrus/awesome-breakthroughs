{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jackburrus/awesome-breakthroughs/schema/pending.schema.json",
  "title": "Pending source",
  "description": "A candidate source that is not listed yet because its URL or key facts have not been confirmed. One YAML file per candidate under pending/<id>.yaml.",
  "type": "object",
  "required": ["id", "name", "field", "reason", "to_check"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Must match the file name."},
    "name": {"type": "string", "minLength": 1},
    "url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "field": {"$ref": "source.schema.json#/$defs/field"},
    "reason": {"type": "string", "minLength": 1, "description": "Why the candidate is not listed yet."},
    "to_check": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "last_checked": {"type": "string", "format": "date"},
    "notes": {"type": "string"}
  }
}
